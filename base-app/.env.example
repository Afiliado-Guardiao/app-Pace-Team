# Supabase — backend do app
# Pegue em: Supabase Dashboard -> Project Settings -> API
# A "anon key" aparece como "publishable key" (sb_publishable_...) em projetos novos.
# É a chave PÚBLICA — pode ir no app com segurança.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PostHog Analytics (opcional)
# Get these from: https://posthog.com/project/settings
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry Error Monitoring (opcional)
# Get DSN from: https://sentry.io/settings/projects/baseapp/keys/
# Automatically disabled in development (__DEV__), only active in production
EXPO_PUBLIC_SENTRY_DSN=

# Superwall — apresentação do paywall (paywalls remotos, A/B no dashboard)
# Get the API keys from: https://superwall.com/ → Settings → Keys
# Uma chave pública por plataforma (formato pk_...). Sem elas o SDK não
# apresenta paywalls, mas o template roda normalmente até você configurar.
EXPO_PUBLIC_SUPERWALL_IOS_API_KEY=
EXPO_PUBLIC_SUPERWALL_ANDROID_API_KEY=

# Paywallo — identidade/tracking, funil de onboarding e fonte de verdade de
# assinatura (via paywallo-webhook no backend). Coexiste com o Superwall.
# Get the appKey from: https://paywallo.com.br/dashboard → your app → Settings
EXPO_PUBLIC_PAYWALLO_APP_KEY=
