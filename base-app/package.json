{
	"name": "app-base",
	"version": "1.0.0",
	"main": "expo-router/entry",
	"scripts": {
		"start": "expo start",
		"android": "npx expo run:android --device",
		"ios": "npx expo run:ios --device",
		"web": "expo start --web",
		"eas:dev:ios": "eas build --profile development --platform ios",
		"eas:dev:android": "eas build --profile development --platform android",
		"eas:preview": "eas build --profile preview --platform all",
		"eas:build:ios": "eas build --profile production --platform ios",
		"eas:build:android": "eas build --profile production --platform android",
		"eas:testflight": "eas build --profile production --platform ios --auto-submit",
		"eas:submit:ios": "eas submit --profile production --platform ios",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"lint": "eslint .",
		"check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" && eslint . && tsc --noEmit",
		"fix": "eslint . --fix && prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@expo-google-fonts/inter": "^0.2.3",
		"@expo/metro-runtime": "~6.1.2",
		"@quidone/react-native-wheel-picker": "^1.6.1",
		"@react-native-async-storage/async-storage": "^2.2.0",
		"@supabase/supabase-js": "^2.106.1",
		"@tanstack/react-query": "^5.90.2",
		"@virex-tech/paywallo-sdk": "^2.10.1",
		"expo": "54.0.23",
		"expo-application": "~7.0.7",
		"expo-clipboard": "~7.0.0",
		"expo-constants": "~18.0.10",
		"expo-crypto": "~15.0.7",
		"expo-dev-client": "~6.0.21",
		"expo-device": "~8.0.9",
		"expo-font": "~14.0.8",
		"expo-haptics": "^15.0.7",
		"expo-linking": "~8.0.8",
		"expo-localization": "~17.0.7",
		"expo-router": "~6.0.13",
		"expo-splash-screen": "~31.0.10",
		"expo-status-bar": "~3.0.8",
		"expo-superwall": "^1.0.5",
		"i18next": "^24.2.3",
		"phosphor-react-native": "^3.0.1",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-i18next": "^15.7.4",
		"react-native": "0.81.5",
		"react-native-keyboard-controller": "1.18.5",
		"react-native-reanimated": "~4.1.1",
		"react-native-safe-area-context": "~5.6.0",
		"react-native-screens": "~4.16.0",
		"react-native-svg": "15.12.1",
		"react-native-worklets": "0.5.1",
		"zod": "^3.24.4",
		"zustand": "^5.0.8"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@testing-library/react-native": "^12.4.3",
		"@types/jest": "^29.5.12",
		"@types/react": "~19.1.0",
		"@typescript-eslint/eslint-plugin": "^8.18.2",
		"@typescript-eslint/parser": "^8.18.2",
		"babel-plugin-module-resolver": "^5.0.2",
		"babel-preset-expo": "~54.0.3",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.1",
		"eslint-plugin-react": "^7.37.3",
		"eslint-plugin-react-hooks": "^5.1.0",
		"eslint-plugin-react-native": "^5.0.0",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-unused-imports": "^4.2.0",
		"jest": "^29.7.0",
		"jest-expo": "~54.0.0",
		"prettier": "^3.4.2",
		"react-test-renderer": "19.1.0",
		"typescript": "~5.9.2",
		"typescript-eslint": "^8.46.0"
	},
	"private": true
}
