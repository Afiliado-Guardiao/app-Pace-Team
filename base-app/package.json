{
  "name": "pace-team",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "npx expo run:android --device",
    "ios": "npx expo run:ios --device",
    "web": "expo start --web",
    "eas:dev:ios": "eas build --profile development --platform ios",
    "eas:dev:android": "eas build --profile development --platform android",
    "eas:preview": "eas build --profile preview --platform all",
    "eas:build:ios": "eas build --profile production --platform ios",
    "eas:build:android": "eas build --profile production --platform android",
    "eas:testflight": "eas build --profile production --platform ios --auto-submit",
    "eas:submit:ios": "eas submit --profile production --platform ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\" && eslint . && tsc --noEmit",
    "fix": "eslint . --fix && prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
