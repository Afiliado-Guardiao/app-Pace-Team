{
	"name": "pushtime-server",
	"version": "1.0.0",
	"description": "Modern authentication server with TypeScript, Fastify, and OAuth support",
	"main": "dist/server.js",
	"type": "commonjs",
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"build": "tsup",
		"start": "node dist/server.js",
		"test": "jest --silent --runInBand",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:integration": "NODE_ENV=test jest --runInBand --detectOpenHandles",
		"test:integration:watch": "NODE_ENV=test jest --runInBand --watch",
		"lint": "eslint .",
		"check": "prettier --check \"**/*.{ts,js,json,md}\" && eslint . && tsc --noEmit",
		"fix": "eslint . --fix && prettier --write \"**/*.{ts,js,json,md}\"",
		"typecheck": "tsc --noEmit",
		"docker": "tsx scripts/docker-env.ts",
		"docker:up": "npm run docker -- up -d --build",
		"docker:down": "tsx scripts/docker-cleanup.ts --shutdown",
		"docker:clean": "tsx scripts/docker-cleanup.ts",
		"docker:logs": "npm run docker -- logs api --tail 200 -f",
		"docker:exec:api": "npm run docker -- exec api sh",
		"docker:exec:db": "tsx scripts/psql-connect.ts",
		"docker:db:push": "docker exec pushtime-api-staging npx prisma db push --accept-data-loss",
		"docker:seed": "docker exec pushtime-api-staging npx tsx prisma/seed.ts",
		"docker:deploy": "tsx scripts/docker-deploy.ts",
		"docker:deploy:clean": "tsx scripts/docker-deploy.ts --clean",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"prisma:deploy": "prisma migrate deploy",
		"prisma:studio": "prisma studio",
		"prisma:seed": "tsx prisma/seed.ts",
		"db:migrate:dev": "prisma migrate dev",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:migrate:reset": "prisma migrate reset --force",
		"db:setup": "npm run prisma:generate && npm run prisma:migrate",
		"db:seed": "npm run prisma:seed",
		"setup:test": "tsx scripts/setup-for-testing.ts"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"keywords": [
		"typescript",
		"fastify",
		"authentication",
		"oauth",
		"prisma",
		"postgresql",
		"jwt"
	],
	"author": "",
	"license": "MIT",
	"dependencies": {
		"@fastify/cookie": "^11.0.2",
		"@fastify/helmet": "^13.0.2",
		"@fastify/jwt": "^10.0.0",
		"@fastify/rate-limit": "^10.3.0",
		"@prisma/client": "^6.19.0",
		"apple-signin-auth": "^1.7.8",
		"bcryptjs": "^2.4.3",
		"dotenv": "^16.4.7",
		"fastify": "^5.6.1",
		"i18next": "^24.2.3",
		"i18next-fs-backend": "^2.3.1",
		"winston": "^3.18.3",
		"zod": "^3.24.4"
	},
	"devDependencies": {
		"@eslint/js": "^9.37.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/jest": "^29.5.14",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^22.10.2",
		"@typescript-eslint/eslint-plugin": "^8.18.2",
		"@typescript-eslint/parser": "^8.18.2",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-prettier": "^5.2.1",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"eslint-plugin-unused-imports": "^4.2.0",
		"jest": "^29.7.0",
		"prettier": "^3.4.2",
		"prisma": "^6.19.0",
		"reflect-metadata": "^0.2.2",
		"supertest": "^7.0.0",
		"ts-jest": "^29.2.5",
		"ts-node": "^10.9.2",
		"tsup": "^8.3.5",
		"tsx": "^4.19.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.46.0"
	},
	"engines": {
		"node": ">=22.0.0",
		"npm": ">=10.0.0"
	}
}
