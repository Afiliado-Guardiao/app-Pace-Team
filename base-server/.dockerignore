# Docker Multi-Stage Build Context
# Este arquivo afeta TODAS as stages do build

# Dependencies (serão instaladas no container)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs (gerados durante o build)
# Não excluímos 'dist' pois é gerado no builder stage
build
.next
out

# Environment files
.env
.env.local
.env.development
.env.test
.env.production
.env.staging
*.env

# Git
.git
.gitignore
.gitattributes

# IDE and editors
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Testing
coverage
.nyc_output
*.lcov

# Logs
logs
*.log

# Docker files (não precisamos copiar dockerfiles para dentro do container)
docker
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Documentation
*.md
README.md
CHANGELOG.md
LICENSE

# Reference files
reference

# Temporary files
tmp
temp
*.tmp

# OS files
.DS_Store
Thumbs.db

# Prisma
# Schema é necessário, migrations serão aplicadas via migrate deploy
# Mantemos schema, excluímos apenas dev.db se existir
*.db
*.db-journal
