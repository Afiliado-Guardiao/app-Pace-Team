# Application
# NODE_ENV controls which Docker environment to use (staging or production)
# For local development without Docker, use 'development'
NODE_ENV=development
BASE_PORT=11000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pushtime_dev

# Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRATION=7d

# Rate Limiting
# Global limit: 40 requests per minute per IP
RATE_LIMIT=40
RATE_LIMIT_TIMEWINDOW=60000
# Tentativas por minuto por IP em /auth/login e /auth/register (brute-force protection)
AUTH_RATE_LIMIT=5

# Logging
LOG_LEVEL=info

# OAuth Social Authentication
# Backend uses trust-based approach: validates socialId hashes from native SDKs
# No token validation required - app SDKs handle OAuth flows natively
