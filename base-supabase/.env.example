# =============================================================================
# base-supabase — variaveis de ambiente
# -----------------------------------------------------------------------------
# Secrets da Edge Function do webhook. Sao enviados ao Supabase com
# `npm run secrets:set`. Copie para `.env`:  cp .env.example .env
#
# IMPORTANTE: nao adicione variaveis com prefixo SUPABASE_ aqui. O Supabase
# reserva esse prefixo e `supabase secrets set` recusa o arquivo inteiro se
# encontrar uma. O Project Ref e a senha do banco voce passa direto nos
# comandos (`supabase link --project-ref ...`), nao via .env.
#
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY tambem NAO vao aqui: a Edge Function
# ja os recebe injetados automaticamente pelo runtime do Supabase.
# =============================================================================

# Segredo que compoe a URL do webhook:
#   https://<projeto>.supabase.co/functions/v1/paywallo-webhook?secret=<este-valor>
# Gere um UUID e use o MESMO valor no dashboard do Paywallo.
PAYWALLO_WEBHOOK_PATH_SECRET=00000000-0000-0000-0000-000000000000

# Segredo para validar a assinatura HMAC-SHA256 (header X-Paywallo-Signature).
# Deixe vazio para desabilitar a verificacao HMAC (nao recomendado em producao).
PAYWALLO_WEBHOOK_HMAC_SECRET=
